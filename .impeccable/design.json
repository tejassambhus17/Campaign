  "narrative": {
    "northStar": "The Clear Signal",
    "overview": "Campaign uses a compact consumer mobile composition: campaign photographs lead discovery, clear sans-serif type gives a message its identity, and concise funding groups make the next action legible. Light pairs a mint identity area with charcoal actions. Dark uses pure black and neutral charcoal grounds, with mint reserved for accents, progress and actions.\n\nThis is the source-derived replacement for the rejected civic-publication ultramarine and large-serif system. The supplied three-screen reference informed proportions and hierarchy; its photographs, people, banking language and donation claims are not Campaign assets or product claims. The user subsequently rejected green-tinted Dark surfaces; that correction is binding while the existing Light palette stays unchanged.\n\nThis document records the React Native implementation on October 16, 2026, not user approval or completed native acceptance. It is grounded in `apps/mobile/src/lib/appearance.ts`, `theme-styles.ts`, `theme.tsx`, `components/ui.tsx` and sampled routes. The prior system remains in `artifacts/checkpoints/before-reference-redesign-20261016-101133`. Current build, capture and acceptance evidence belongs in `PROGRESS.md` and `RELEASE_READINESS.md`.",
    "keyCharacteristics": [
      "Compact Manrope hierarchy and image-led campaign discovery.",
      "Unchanged mint-and-charcoal Light; black-and-neutral-charcoal Dark.",
      "Shared semantic surfaces, visible fields and restrained native feedback.",
      "Five persistent tabs, content-aware docks and scalable native text."
    ],
    "rules": [
      {
        "name": "The Neutral Dark Rule",
        "body": "Dark backgrounds, headers and large containers use their neutral semantic roles. Mint belongs to restrained accents, progress and actions; never replace the neutral grounds with green-tinted surfaces.",
        "section": "colors"
      },
      {
        "name": "The Shared Appearance Rule",
        "body": "Resolve colors through the existing theme provider. Appearance is a device preference independent of identity, drafts and payments; a theme change must preserve the current workflow.",
        "section": "colors"
      },
      {
        "name": "The Compact Type Rule",
        "body": "Use the implemented Manrope hierarchy for both storytelling and tasks. Do not restore the superseded large-serif or ultramarine direction.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Establish hierarchy with semantic surfaces, one-pixel boundaries, spacing and photography. The shared native components define no shadow or motion scale.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the shared semantic Light/Dark palette and preserve the existing Light design.",
      "Do keep Dark grounds neutral, including headers and contribution panels, with mint confined to accents and actions.",
      "Do use Manrope static font files through the shared Text wrapper and let native text scale.",
      "Do retain the five tabs and five visible creation steps, with space for docks, keyboard and system insets.",
      "Do keep campaign identity, funding, estimated reach and the next action coherent, with truthful simulated or estimated labels.",
      "Do verify the actual installed candidate at 360, 393 and 411 logical widths, font scale 1.3 and critical keyboard states before claiming visual acceptance."
    ],
    "donts": [
      "Don't reintroduce green-tinted Dark grounds, oversized serif discovery headings or ultramarine actions from rejected directions.",
      "Don't create parallel per-screen themes, remount navigation to change appearance, or store the preference in account data.",
      "Don't copy the reference's people, photographs, donation wording, banking balances or unsupported trust claims.",
      "Don't add decorative gradients, nested panels, repeated slogans or new motion/shadow tokens that the native system does not define.",
      "Don't treat old green-Dark captures, a successful build, browser snippets or source token checks as acceptance of the corrected installed appearance."
    ]
  }
}
