# Optional client configuration. Leave unset for platform-aware local development:
# web defaults to http://127.0.0.1:8787; Android uses http://10.0.2.2:8787.
# Uncomment only the address appropriate to your device and running API.

# Local browser preview:
# EXPO_PUBLIC_API_URL=http://127.0.0.1:8787

# Android emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8787

# Physical phone on the same network (replace with the API host's LAN address):
# EXPO_PUBLIC_API_URL=http://192.168.1.100:8787

# Standalone production builds need a reachable HTTPS backend:
# EXPO_PUBLIC_API_URL=https://your-campaign-api.example

# EXPO_PUBLIC_* values are bundled into the app. Never put secrets here.
