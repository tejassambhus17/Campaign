{
  "expo": {
    "name": "Campaign",
    "slug": "campaign-amplification",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/campaign-megaphone-transparent.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#000000",
    "splash": {
      "image": "./assets/brand/campaign-megaphone-transparent.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "icon": "./assets/brand/campaign-logo.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.campaignamplification.mobile"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.campaignamplification.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/campaign-megaphone-transparent.png",
        "backgroundColor": "#000000"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/brand/campaign-megaphone-transparent.png",
      "name": "Campaign Amplification",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a profile photo, campaign images and advertising visuals from your library.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-system-ui",
      ["expo-navigation-bar", { "enforceContrast": false, "visibility": "visible" }],
      ["expo-splash-screen", {
        "backgroundColor": "#000000",
        "image": "./assets/brand/campaign-megaphone-transparent.png",
        "imageWidth": 144,
        "resizeMode": "contain",
        "dark": { "backgroundColor": "#000000", "image": "./assets/brand/campaign-megaphone-transparent.png" }
      }],
      "./plugins/withCampaignBranding.cjs"
    ],
    "scheme": "amplify",
    "description": "Community-funded message amplification. All payments and advertising results are simulated."
  }
}
