{
  "name": "campaign-amplification",
  "version": "1.5.1",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "postinstall": "node plugins/campaignActivityResultsPatch.cjs && node plugins/campaignPrintPatch.cjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "export:web": "expo export --platform web",
    "export:android": "expo export --platform android",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.104.3",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~55.0.1",
    "expo": "~55.0.31",
    "expo-application": "~55.0.19",
    "expo-constants": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-image-picker": "~55.0.24",
    "expo-linking": "~55.0.17",
    "expo-navigation-bar": "~55.0.17",
    "expo-print": "~55.0.19",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-sharing": "~55.0.24",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.22",
    "lucide-react-native": "1.59.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-pager-view": "8.0.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-modules-core",
          "expo-print"
        ]
      }
    }
  },
  "engines": {
    "node": ">=20.19.4"
  }
}
