# Reference only: run.py deliberately does not load .env files automatically.
# Set these in the provider's secret environment. Never commit real values.
CAMPAIGN_ENV=cloud
CAMPAIGN_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
CAMPAIGN_MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@DIRECT_NON_POOLER_HOST/DATABASE?sslmode=require
# Reuse the established secret if this database already has guest receipts.
CAMPAIGN_RECEIPT_SECRET=SET_PERSISTENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CAMPAIGN_REVIEWER_EMAIL=SET_PRIVATE_REVIEWER_EMAIL
CAMPAIGN_REVIEWER_PASSWORD=SET_PRIVATE_STRONG_PASSWORD_AT_LEAST_12_CHARACTERS
CAMPAIGN_MEDIA_STORAGE=cloudinary
CLOUDINARY_CLOUD_NAME=SET_CLOUD_NAME
CLOUDINARY_API_KEY=SET_SERVER_ONLY_API_KEY
CLOUDINARY_API_SECRET=SET_SERVER_ONLY_API_SECRET
# Render injects RENDER_EXTERNAL_URL. For another host set the actual origin:
# CAMPAIGN_PUBLIC_BASE_URL=https://YOUR_ACTUAL_CAMPAIGN_BACKEND
# Native clients require no CORS allowlist. Add exact HTTPS web origins if needed.
CAMPAIGN_CORS_ORIGINS=
